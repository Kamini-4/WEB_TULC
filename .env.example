# --- SERVER SIDE VARIABLES ---
# Gemini API Key (Required for AI features)
# In Cloud Run, set this as GEMINI_API_KEY
GEMINI_API_KEY=

# --- CLIENT SIDE VARIABLES (Vite) ---
# Note: These must be prefixed with VITE_ to be accessible in the browser.

# Firebase Configuration (Used via firebase-applet-config.json, but these can be used as fallbacks)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS Configuration (Required for Contact/Waitlist forms)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_ADMIN_EMAIL=

# Google Analytics
VITE_GA_ID=
