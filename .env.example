# ==============================================================================
# The Unbounded Leadership Co. - Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# 1. Never commit your actual .env file or real secrets to git version control.
# 2. Copy this template to .env and populate with your production credentials.
# 3. Rotate any secrets immediately if they were ever exposed in history or logs.
# 4. In NODE_ENV=production, the server will refuse to start if critical
#    variables (GEMINI_API_KEY, PORTAL_CLEARANCE_KEYS, JWT_SECRET,
#    ALLOWED_ORIGINS) are unset or still contain placeholder values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node & Server Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Debug mode MUST remain false in production (defaults to false)
DEBUG=false
# Set to true when deployed behind Cloud Run, Cloudflare, or Nginx reverse proxy
TRUST_PROXY=true

# ------------------------------------------------------------------------------
# 2. Strict CORS Origin Allowlist (Server-Side Only - NEVER use *)
# Comma-separated list of authorized frontend origins
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=https://theunboundedleadership.com,https://www.theunboundedleadership.com

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Signing Secret (Server-Side Only, >= 32 random chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_at_least_32_char_cryptographically_random_secret

# ------------------------------------------------------------------------------
# 4. Razorpay Payment Gateway & Webhook Verification (Server-Side Secrets)
# Key Secret & Webhook Secret must NEVER use VITE_ prefix or enter client code.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 5. Google Gemini API (Server-Side Only - NEVER expose to frontend client)
# Used by server.js /api/ai/generate proxy to run executive memorandum synthesis
# ------------------------------------------------------------------------------
GEMINI_API_KEY=replace_with_server_gemini_api_key

# ------------------------------------------------------------------------------
# 6. Institutional Portal Clearance Master Keys (Server-Side Only)
# Comma-separated list of high-entropy passkeys (never commit real keys)
# ------------------------------------------------------------------------------
PORTAL_CLEARANCE_KEYS=replace_with_unique_passkey_alpha,replace_with_unique_passkey_beta

# ------------------------------------------------------------------------------
# 7. Optional Database Connection (Server-Side Only)
# If configured in production, TLS/SSL MUST be enforced (e.g. ?sslmode=require)
# and default credentials (postgres:postgres, admin:admin, etc.) are rejected.
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://app_user:strong_secret@db.internal:5432/tulc_prod?sslmode=require
# REQUIRE_DATABASE=false

# ------------------------------------------------------------------------------
# 8. Optional Email & Search Integrations (Server-Side Only)
# ------------------------------------------------------------------------------
RESEND_API_KEY=replace_with_resend_api_key
ADMIN_EMAIL=suchita@theunboundedleadership.com
SENDER_EMAIL=suchita@theunboundedleadership.com
SENDER_NAME=The Unbounded Leadership Co.
BING_INDEXNOW_KEY=replace_with_bing_indexnow_key

# ------------------------------------------------------------------------------
# 9. External Audit & Substrate URLs (Non-sensitive)
# ------------------------------------------------------------------------------
SOVEREIGN_AUDIT_TARGET_URL=https://institutional-assessment.ai.studio/

# ------------------------------------------------------------------------------
# 10. Client-Safe Public Configuration (VITE_ prefix exposed to browser bundle)
# WARNING: NEVER put secret API keys, private tokens, or database passwords here!
# ------------------------------------------------------------------------------
VITE_APP_URL=https://theunboundedleadership.com
VITE_ADMIN_EMAIL=suchita@theunboundedleadership.com
VITE_SENDER_EMAIL=suchita@theunboundedleadership.com
VITE_SENDER_NAME=The Unbounded Leadership Co.
VITE_GA_MEASUREMENT_ID=G-TULCLEAD01
