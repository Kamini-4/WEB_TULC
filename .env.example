# --- SERVER SIDE VARIABLES ---
# Gemini API Key (Required for AI features)
# In Cloud Run, set this as GEMINI_API_KEY
GEMINI_API_KEY=

# --- CLIENT SIDE VARIABLES (Vite) ---
# Note: These must be prefixed with VITE_ to be accessible in the browser.

# Firebase Configuration (Used via firebase-applet-config.json, but these can be used as fallbacks)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Resend API Key (for backend email notifications)
RESEND_API_KEY=

# Email Configuration (Backend)
VITE_ADMIN_EMAIL=suchita135sancheti@gmail.com
VITE_SENDER_EMAIL=concierge@theunboundedleadership.com
VITE_SENDER_NAME=The Unbounded Leadership Co.

# EmailJS Configuration (Required for Contact/Waitlist forms if using frontend client)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_ADMIN_EMAIL=

# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=
