# --- SERVER SIDE VARIABLES ---
# Gemini API Key (Required for AI features)
# In Cloud Run, set this as GEMINI_API_KEY
GEMINI_API_KEY=

# Resend API Key (for backend email notifications)
RESEND_API_KEY=

# --- CLIENT SIDE VARIABLES (Vite) ---
# Note: These must be prefixed with VITE_ to be accessible in the browser.

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email Configuration (Backend)
# IMPORTANT: You MUST verify the domain "theunboundedleadership.com" in Resend to send to external users.
VITE_ADMIN_EMAIL=
VITE_SENDER_EMAIL=
VITE_SENDER_NAME=

# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=
