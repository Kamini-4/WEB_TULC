# ==============================================================================
# The Unbounded Leadership Co. - Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# 1. Never commit your actual .env file or real secrets to git version control.
# 2. Copy this template to .env and populate with your production credentials.
# 3. Rotate any secrets immediately if they were ever exposed in history or logs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node & Server Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Google Gemini API (Server-Side Only - NEVER expose to frontend client)
# Used by server.js /api/ai/ proxy to run executive memorandum & boardroom sparring
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Resend Email Dispatch (Server-Side Only)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_EMAIL=suchita@theunboundedleadership.com
SENDER_EMAIL=suchita@theunboundedleadership.com
SENDER_NAME=The Unbounded Leadership Co.

# ------------------------------------------------------------------------------
# 4. Search Engine IndexNow Integration (Server-Side Only)
# ------------------------------------------------------------------------------
BING_INDEXNOW_KEY=your_bing_indexnow_api_key_here

# ------------------------------------------------------------------------------
# 5. Institutional Portal Clearance Master Keys (Server-Side Only)
# Comma-separated list of authorized master enterprise passkeys
# ------------------------------------------------------------------------------
PORTAL_CLEARANCE_KEYS=KEY_ENTERPRISE_ALPHA_01,KEY_ENTERPRISE_BETA_02

# ------------------------------------------------------------------------------
# 6. External Audit & Substrate URLs (Non-sensitive)
# ------------------------------------------------------------------------------
SOVEREIGN_AUDIT_TARGET_URL=https://institutional-assessment.ai.studio/

# ------------------------------------------------------------------------------
# 7. Client-Safe Public Configuration (VITE_ prefix exposed to browser bundle)
# WARNING: NEVER put secret API keys, private tokens, or database passwords here!
# ------------------------------------------------------------------------------
VITE_APP_URL=https://theunboundedleadership.com
VITE_ADMIN_EMAIL=suchita@theunboundedleadership.com
VITE_SENDER_EMAIL=suchita@theunboundedleadership.com
VITE_SENDER_NAME=The Unbounded Leadership Co.
VITE_GA_MEASUREMENT_ID=G-TULCLEAD01
