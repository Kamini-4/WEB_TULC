{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A potential client inquiry from the intake terminal.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the lead." },
        "email": { "type": "string", "format": "email", "description": "Work email address." },
        "organization": { "type": "string", "description": "Organization name." },
        "role": { "type": "string", "description": "Institutional role." },
        "message": { "type": "string", "description": "Yield target or message." },
        "timestamp": { "type": "number", "description": "Creation timestamp." },
        "type": { "type": "string", "enum": ["intake"] }
      },
      "required": ["name", "email", "organization", "message", "timestamp"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "A completed yield calibration assessment.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID." },
        "email": { "type": "string", "format": "email", "description": "Email of the participant." },
        "context": { "type": "string", "enum": ["dynamic", "established", "generational"], "description": "Institutional context." },
        "answers": { "type": "object", "description": "Map of question index to score (0, 5, 10)." },
        "totalScore": { "type": "number", "description": "Sum of all scores." },
        "percentage": { "type": "number", "description": "Maturity percentage." },
        "timestamp": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "type": { "type": "string", "enum": ["assessment"] }
      },
      "required": ["email", "context", "answers", "totalScore", "timestamp"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "An institutional dispatch in the registry.",
      "type": "object",
      "properties": {
        "category": { "type": "string", "description": "Blog category." },
        "date": { "type": "string", "description": "Display date (e.g. Q1 2026)." },
        "title": { "type": "string", "description": "Post title." },
        "excerpt": { "type": "string", "description": "Short summary." },
        "content": { "type": "array", "items": { "type": "string" }, "description": "Paragraphs of content." },
        "timestamp": { "type": "number", "description": "Creation timestamp." }
      },
      "required": ["title", "content", "timestamp"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "A scheduled email reminder for the scheduler.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "organization": { "type": "string" },
        "type": { "type": "string", "enum": ["FOLLOW_UP_1", "FOLLOW_UP_2"] },
        "scheduledFor": { "type": "string", "format": "date-time" },
        "sent": { "type": "boolean" }
      },
      "required": ["email", "name", "type", "scheduledFor", "sent"]
    },
    "EmailLog": {
      "title": "EmailLog",
      "description": "A record of an outbound email dispatch, tracking successful delivery and detailed failure diagnostics.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["contact_admin", "contact_user", "newsletter_broadcast"] },
        "recipient": { "type": "string", "format": "email" },
        "sender": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "failed"] },
        "error": { "type": "string" },
        "resendId": { "type": "string" },
        "timestamp": { "type": "number" },
        "metadata": { "type": "object" }
      },
      "required": ["type", "recipient", "sender", "subject", "status", "timestamp"]
    }
  },
  "firestore": {
    "leads": {
      "schema": "Lead",
      "description": "Collection of intake inquiries."
    },
    "assessments": {
      "schema": "Assessment",
      "description": "Collection of yield calibration results."
    },
    "blog": {
      "schema": "BlogPost",
      "description": "Collection of registry dispatches."
    },
    "reminders": {
      "schema": "Reminder",
      "description": "Collection of scheduled email reminders."
    },
    "email_logs": {
      "schema": "EmailLog",
      "description": "Collection of sent and failed email outbound logs for administrative auditing."
    }
  }
}
